digraph ER {
  graph [rankdir=LR, fontname="Arial", pad=0.4, nodesep=0.6, ranksep=1.3, bgcolor="white", label=<<b>Modelo conceptual de colecciones MongoDB — PRESTA+</b>>, labelloc=t, fontsize=18, fontcolor="#23404A"];
  node  [fontname="Arial", fontsize=11, shape=plain];
  edge  [fontname="Arial", fontsize=10, color="#496A73", fontcolor="#30383B", penwidth=1.4, arrowhead=crow, arrowtail=none, dir=both, arrowtail=tee];

  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#23404A"><tr><td bgcolor="#23404A"><font color="white"><b>users</b></font></td></tr><tr><td align="left" bgcolor="#F5F3EE">_id · email (único) · password (bcrypt)<br align="left"/>role: cliente|empleado|admin<br align="left"/>documentId (AES-256-GCM) · isVerified · active<br align="left"/>otpHash · resetTokenHash (select:false)<br align="left"/></td></tr></table>>];
  collaterals [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#23404A"><tr><td bgcolor="#23404A"><font color="white"><b>collaterals</b></font></td></tr><tr><td align="left" bgcolor="#F5F3EE">_id · owner → users<br align="left"/>category · brand · model · serialNumber<br align="left"/>condition · photos[1..5] · declaredValue<br align="left"/>estimatedValue · appraisedValue<br align="left"/>status · custodyLocation<br align="left"/></td></tr></table>>];
  requests [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#23404A"><tr><td bgcolor="#23404A"><font color="white"><b>loanrequests</b></font></td></tr><tr><td align="left" bgcolor="#F5F3EE">_id · client → users · collateral → collaterals (único)<br align="left"/>requestedAmount · termDays · status<br align="left"/>preEvaluation{} · appraisal{marketValue, maxLoan,<br align="left"/>monthlyRate, appraisedBy → users}<br align="left"/>approvedAmount · reviewedBy · rejectionReason · loan → loans<br align="left"/></td></tr></table>>];
  loans [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#23404A"><tr><td bgcolor="#23404A"><font color="white"><b>loans</b></font></td></tr><tr><td align="left" bgcolor="#F5F3EE">_id · contractNumber (único) · client → users<br align="left"/>collateral → collaterals · request → loanrequests<br align="left"/>principal · outstandingPrincipal · monthlyRate<br align="left"/>termDays · startDate · dueDate · interestPaidUntil<br align="left"/>status: activo|vencido|rescatado<br align="left"/>contract{generatedAt, clauses[]}<br align="left"/></td></tr></table>>];
  payments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#23404A"><tr><td bgcolor="#23404A"><font color="white"><b>payments</b></font></td></tr><tr><td align="left" bgcolor="#F5F3EE">_id · loan → loans · type · amount<br align="left"/>interestPortion · capitalPortion · balanceAfter<br align="left"/>receiptNumber (único) · registeredBy → users · paidAt<br align="left"/></td></tr></table>>];
  notifications [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#23404A"><tr><td bgcolor="#496A73"><font color="white"><b>notifications</b></font></td></tr><tr><td align="left" bgcolor="#F5F3EE">_id · user → users · type · title · message<br align="left"/>read · loan → loans · request → loanrequests<br align="left"/>TTL 180 días<br align="left"/></td></tr></table>>];
  counters [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#496A73"><tr><td bgcolor="#496A73"><font color="white"><b>counters</b></font></td></tr><tr><td align="left" bgcolor="#F5F3EE">_id ("PRE-2026" | "REC-2026") · seq<br align="left"/></td></tr></table>>];

  users -> collaterals [label="1 : N  (owner)"];
  users -> requests [label="1 : N  (client)"];
  collaterals -> requests [label="1 : 1"];
  requests -> loans [label="1 : 0..1\n(aprobada)"];
  users -> loans [label="1 : N  (client)"];
  loans -> payments [label="1 : N"];
  users -> notifications [label="1 : N"];
}
